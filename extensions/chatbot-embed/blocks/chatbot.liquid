{%- assign merchant_id = shop.metafields.chekout_ai.merchant_id.value -%}
{%- assign chatbot_src = shop.metafields.chekout_ai.chatbot_src.value | default: 'https://ai-builder.chekout.ai/chatbot.js' -%}

{% if merchant_id != blank %}
  <script
    src="{{ chatbot_src }}"
    data-agent-id="{{ merchant_id }}"
    data-allow-iframe="true"
    defer>
  </script>
{% endif %}

{% schema %}
{
  "name": "ChekoutAI Chatbot",
  "target": "body",
  "settings": []
}
{% endschema %}
